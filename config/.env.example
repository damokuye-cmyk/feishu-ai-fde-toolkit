# 🦞 Feishu AI FED Toolkit - 全局配置
# 复制此文件为 .env 并填入你的配置

# === AI 模型 API Key ===
OPENAI_API_KEY=sk-your-openai-key
DEEPSEEK_API_KEY=sk-your-deepseek-key
QWEN_API_KEY=sk-your-qwen-key

# === LiteLLM 配置 ===
LITELLM_MASTER_KEY=sk-litellm-master-key-123456
DATABASE_URL=postgresql://llmproxy:llmproxy@postgres:5432/llmproxy

# === 飞书 OpenClaw 配置 ===
FEISHU_APP_ID=cli_your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret

# === Agent 配置 ===
AGENT_LOG_LEVEL=INFO
DEFAULT_LLM_MODEL=deepseek-chat

# === 监控配置 ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# === 部署环境 ===
DEPLOY_ENV=development  # development | production
